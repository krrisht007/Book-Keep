<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Without this, a sandboxed macOS release build can't make any
	     outgoing network connection at all — every backend API call,
	     Firebase, everything, would fail immediately at the OS sandbox
	     level regardless of ATS. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
