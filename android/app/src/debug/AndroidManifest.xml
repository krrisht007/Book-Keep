<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:usesCleartextTraffic="true">
        <!-- Some Android emulator images (seen on the 16k-page-size preview
             images) crash Impeller's GLES backend on startup — "Texture mip
             count is > 1, but the mipmap has not been generated" — a
             renderer/emulator compatibility bug, not an app bug. Debug-only
             (this file doesn't merge into release builds), so real devices
             keep Impeller; only local emulator testing falls back to Skia. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
